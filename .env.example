# ── Provider selection ──────────────────────────────────────────────────────
# Set to "openai", "bedrock", "vertex", or "ollama"
LLM_PROVIDER=ollama

# ── OpenAI (used when LLM_PROVIDER=openai) ──────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ── AWS Bedrock (used when LLM_PROVIDER=bedrock) ─────────────────────────────
# Auth option 1 — Bedrock-scoped API keys (highest priority, recommended)
# Use these to isolate Bedrock credentials from other AWS services.
BEDROCK_ACCESS_KEY_ID=AKIAxxx...
BEDROCK_SECRET_ACCESS_KEY=xxx...
BEDROCK_SESSION_TOKEN=...          # optional, for STS/assumed-role temporary credentials
BEDROCK_REGION=us-east-1

# Auth option 2 — Generic AWS credential chain (used if BEDROCK_ACCESS_KEY_ID is not set)
# boto3 will check these, then ~/.aws/credentials, then IAM instance/task role.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=...
AWS_REGION=us-east-1

# Chat model — Claude 3.5 Sonnet (default), Haiku, or Opus
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_CHAT_MODEL=anthropic.claude-3-opus-20240229-v1:0

# Embedding model — Titan Embeddings V2 (1024-dim)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ── GCP Vertex AI (used when LLM_PROVIDER=vertex) ────────────────────────────
# Auth: Application Default Credentials (ADC)
#   Local:      gcloud auth application-default login
#   GCE/GKE:    attach service account with roles/aiplatform.user
#   Key file:   GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Chat model — Gemini 1.5 Pro (default)
VERTEX_CHAT_MODEL=gemini-1.5-pro-002
# VERTEX_CHAT_MODEL=gemini-1.5-flash-002
# VERTEX_CHAT_MODEL=gemini-2.0-flash-001

# Embedding model — text-embedding-004 (768-dim)
VERTEX_EMBEDDING_MODEL=text-embedding-004

# ── Ollama (used when LLM_PROVIDER=ollama) ───────────────────────────────────
# Ollama must be running locally (or accessible at OLLAMA_BASE_URL).
# Install: https://ollama.com/download
# Pull models before use, e.g.: ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Chat model — llama3.2 (default), llama3.1, mistral, gemma3, phi4, etc.
OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_CHAT_MODEL=mistral

# Embedding model — nomic-embed-text (768-dim, default), mxbai-embed-large, all-minilm
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Common ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
RUNBOOKS_DIR=./docs

# ── Slack (optional) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
